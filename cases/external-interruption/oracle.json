{
  "schema_version":1,"case_id":"external-interruption","route":"strict",
  "stages":[{"request":"request.md"}],
  "mutable_inputs":["external/service-state.json","work/task-progress/external-recovery.md"],
  "checks":[
    {"id":"no-duplicate","kind":"external","path":"external/service-state.json","expected":{"applied":true,"apply_count":1,"execute_count":1},"minimum":{"query_count":1}},
    {"id":"query-receipt","kind":"json","path":"external/query-receipt.json","expected":{"status":"applied","operation_id":"publish-1","idempotency_key":"publish-key-1","attempt_id":"attempt-1","attempt_sequence":1,"revision":"r1"}},
